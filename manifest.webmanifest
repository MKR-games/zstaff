{
  "id": "/zescape/",
  "name": "직원 스케줄러",
  "short_name": "스케줄러",
  "description": "직원 근무 스케줄과 개인 일정을 확인하는 설치형 웹앱",
  "lang": "ko-KR",
  "dir": "ltr",
  "start_url": "/zescape/",
  "scope": "/zescape/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F5F6F8",
  "theme_color": "#F5F6F8",
  "categories": ["productivity", "business"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
